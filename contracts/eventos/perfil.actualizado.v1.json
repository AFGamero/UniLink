{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perfil.actualizado.v1.json",
  "title": "perfil.actualizado (datos v1)",
  "description": "Publicado cuando cambian datos del perfil que afectan a la búsqueda, las sugerencias o la visibilidad. Productor: usuarios.",
  "type": "object",
  "required": [
    "usuario_id",
    "campos"
  ],
  "properties": {
    "usuario_id": {
      "type": "string",
      "format": "uuid"
    },
    "campos": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "DATOS_BASICOS",
          "UNIDAD_ACADEMICA",
          "ETIQUETAS",
          "TRAYECTORIA",
          "FOTO",
          "PRIVACIDAD"
        ]
      }
    }
  },
  "additionalProperties": false
}
