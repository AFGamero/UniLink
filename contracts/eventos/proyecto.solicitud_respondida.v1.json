    },
    "proyecto_id": {
      "type": "string",
      "format": "uuid"
    },
    "solicitante_id": {
      "type": "string",
      "format": "uuid"
    },
    "aprobada": {
      "type": "boolean"
    },
    "nombre_proyecto": {
      "type": "string",
